	["Episch"] = { order = 4, color = Color3.fromRGB(205, 100, 255), catchBase = 0.15, xpMult = 2.0 },
	["Legendär"] = { order = 5, color = Color3.fromRGB(255, 200, 40), catchBase = 0.08, xpMult = 3.0 },
}

