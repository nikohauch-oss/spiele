			<Item class="ModuleScript" referent="RBX2">
				<Properties>
					<string name="Name">Remotes</string>
					<ProtectedString name="Source">-- Verwaltet alle RemoteEvents zwischen Server und Client.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local FOLDER_NAME = "BrainWordsRemotes"

local NAMES = {
	"ClientReady", -- Client -&gt; Server: UI ist geladen, bitte Daten senden
	"DataSync", -- Server -&gt; Client: Team/Box/Dex-Daten
	"Notify", -- Server -&gt; Client: kleine Nachricht (Toast)
	"StarterOffer", -- Server -&gt; Client: Starterauswahl anzeigen
	"StarterChoose", -- Client -&gt; Server: gewaehlter Starter
	"BattleStart", -- Server -&gt; Client: Kampf beginnt
	"BattleUpdate", -- Server -&gt; Client: Rundenergebnis
	"BattleAction", -- Client -&gt; Server: Aktion (Angriff/Fangen/...)
	"TeamAction", -- Client -&gt; Server: Team verwalten
}

-- Wird einmal vom Server aufgerufen
function Remotes.InitServer()
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	for _, name in ipairs(NAMES) do
		local ev = Instance.new("RemoteEvent")
		ev.Name = name
		ev.Parent = folder
	end
	folder.Parent = ReplicatedStorage
end

-- Holt ein RemoteEvent (wartet notfalls, bis es existiert)
function Remotes.Get(name)
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	return folder:WaitForChild(name)
end

return Remotes
</ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX18">
		<Item class="Folder" referent="RBX17">
			<Properties>
				<string name="Name">Server</string>
			</Properties>
			<Item class="Script" referent="RBX3">
				<Properties>
					<string name="Name">Main</string>
					<ProtectedString name="Source">-- ============================================================
-- BRAIN WORDS - Server-Start
-- Baut die Welt, laedt die Spielerdaten und startet alles.
-- ============================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

-- RemoteEvents zuerst, damit der Client nichts verpasst
Remotes.InitServer()

local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local MapBuilder = require(script.Parent:WaitForChild("MapBuilder"))
local SpawnService = require(script.Parent:WaitForChild("SpawnService"))
local BattleService = require(script.Parent:WaitForChild("BattleService"))

MapBuilder.Build()
PlayerData.Init()
BattleService.Init()

-- Waehrend eines Kampfes darf das Team nicht umgebaut werden
PlayerData.IsBusy = BattleService.IsInBattle

-- Klick auf ein wildes Brain Word -&gt; Kampf starten
SpawnService.Init(function(player, model)
	BattleService.TryStartWild(player, model)
end)

print("[BrainWords] Server gestartet - viel Spaß beim Fangen!")
</ProtectedString>
