				<Item class="LocalScript" referent="RBX8">
					<Properties>
						<string name="Name">Main</string>
						<ProtectedString name="Source">-- ============================================================
-- BRAIN WORDS - Client-Start
-- Verbindet die UI mit dem Server und animiert die
-- wilden Brain Words in der Welt.
-- ============================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local MenuUi = require(script.Parent:WaitForChild("MenuUi"))
local BattleUi = require(script.Parent:WaitForChild("BattleUi"))

-- ---------- RemoteEvents ----------
local ClientReady = Remotes.Get("ClientReady")
local DataSync = Remotes.Get("DataSync")
local Notify = Remotes.Get("Notify")
local StarterOffer = Remotes.Get("StarterOffer")
local StarterChoose = Remotes.Get("StarterChoose")
local BattleStart = Remotes.Get("BattleStart")
local BattleUpdate = Remotes.Get("BattleUpdate")
local BattleAction = Remotes.Get("BattleAction")
local TeamAction = Remotes.Get("TeamAction")

-- ---------- UI aufbauen ----------
MenuUi.Init({
	onTeamAction = function(op, index)
		TeamAction:FireServer(op, index)
	end,
	onStarterPick = function(id)
		StarterChoose:FireServer(id)
	end,
})
BattleUi.Init(function(action)
	BattleAction:FireServer(action)
end)

-- ---------- Server-Nachrichten ----------
DataSync.OnClientEvent:Connect(function(data)
	MenuUi.SetData(data)
end)

Notify.OnClientEvent:Connect(function(msg, kind)
	UiKit.Toast(msg, kind)
end)

StarterOffer.OnClientEvent:Connect(function(options)
	MenuUi.ShowStarter(options)
end)

BattleStart.OnClientEvent:Connect(function(payload)
	MenuUi.CloseAll()
	BattleUi.Start(payload)
end)

BattleUpdate.OnClientEvent:Connect(function(payload)
	BattleUi.Update(payload)
end)

-- ---------- Wilde Brain Words schweben lassen ----------
local floating = {} -- [part] = { phase, gui }

local function watch(part)
	floating[part] = { phase = math.random() * math.pi * 2, gui = nil }
end

for _, part in ipairs(CollectionService:GetTagged("BrainWordSpawn")) do
	watch(part)
end
CollectionService:GetInstanceAddedSignal("BrainWordSpawn"):Connect(watch)
CollectionService:GetInstanceRemovedSignal("BrainWordSpawn"):Connect(function(part)
	floating[part] = nil
end)

RunService.Heartbeat:Connect(function()
	local t = os.clock()
	for part, info in pairs(floating) do
		if part.Parent then
			if not info.gui then
				info.gui = part:FindFirstChildOfClass("BillboardGui")
			end
			if info.gui then
				info.gui.StudsOffset = Vector3.new(0, 2.8 + math.sin(t * 2 + info.phase) * 0.5, 0)
			end
		else
			floating[part] = nil
		end
	end
end)

-- ---------- Fertig: Server Bescheid geben ----------
ClientReady:FireServer()
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX9">
					<Properties>
						<string name="Name">UiKit</string>
						<ProtectedString name="Source">-- ============================================================
-- Kleine Helfer zum Bauen der Benutzeroberflaeche.
-- ============================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local UiKit = {}

UiKit.Colors = {
	Panel = Color3.fromRGB(40, 40, 62),
	PanelLight = Color3.fromRGB(58, 58, 88),
	Text = Color3.fromRGB(255, 255, 255),
	TextDim = Color3.fromRGB(190, 190, 210),
	Good = Color3.fromRGB(90, 200, 110),
	Bad = Color3.fromRGB(230, 90, 90),
	Accent = Color3.fromRGB(255, 190, 60),
	Blue = Color3.fromRGB(80, 150, 255),
}

local clickSound = Instance.new("Sound")
clickSound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
clickSound.Volume = 0.35
clickSound.Parent = SoundService

function UiKit.Click()
	SoundService:PlayLocalSound(clickSound)
end

local function playerGui()
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

-- Erzeugt eine Instanz mit Eigenschaften
function UiKit.Mk(className, props)
	local inst = Instance.new(className)
	local parent = nil
	for k, v in pairs(props) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UiKit.Screen(name, displayOrder)
	return UiKit.Mk("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = displayOrder or 1,
		Parent = playerGui(),
	})
end

function UiKit.Round(inst, px)
	UiKit.Mk("UICorner", { CornerRadius = UDim.new(0, px or 10), Parent = inst })
	return inst
end

function UiKit.Stroke(inst, color, thickness)
	UiKit.Mk("UIStroke", {
		Color = color or Color3.fromRGB(15, 15, 25),
		Thickness = thickness or 2,
		Parent = inst,
	})
	return inst
end

function UiKit.Label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = UiKit.Colors.Text,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return UiKit.Mk("TextLabel", defaults)
end

function UiKit.Button(props, callback)
	local defaults = {
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = UiKit.Colors.Text,
		BackgroundColor3 = UiKit.Colors.PanelLight,
		AutoButtonColor = true,
		BorderSizePixel = 0,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	local btn = UiKit.Mk("TextButton", defaults)
	UiKit.Round(btn, 10)
	UiKit.Stroke(btn)
	UiKit.Mk("UIPadding", {
		PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
		Parent = btn,
	})
	if callback then
		btn.Activated:Connect(function()
			UiKit.Click()
			callback()
		end)
	end
	return btn
end

-- Lebensbalken: gibt eine Tabelle mit Set(hp, maxHp, sofort) zurueck
function UiKit.HpBar(props)
	local frame = UiKit.Mk("Frame", {
		BackgroundColor3 = Color3.fromRGB(25, 25, 38),
		BorderSizePixel = 0,
		Size = props.Size,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		Parent = props.Parent,
	})
	UiKit.Round(frame, 6)
	local fill = UiKit.Mk("Frame", {
		BackgroundColor3 = UiKit.Colors.Good,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = frame,
	})
	UiKit.Round(fill, 6)

	local api = {}
	function api.Set(hp, maxHp, instant)
		local frac = 0
		if maxHp &gt; 0 then
			frac = math.max(0, math.min(1, hp / maxHp))
		end
		local color = UiKit.Colors.Good
		if frac &lt;= 0.25 then
			color = UiKit.Colors.Bad
		elseif frac &lt;= 0.5 then
			color = UiKit.Colors.Accent
		end
		fill.BackgroundColor3 = color
		local goal = UDim2.new(frac, 0, 1, 0)
		if instant then
			fill.Size = goal
		else
			TweenService:Create(fill, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = goal }):Play()
		end
	end
	return api
end

-- Kleine Nachrichten oben in der Mitte
local toastContainer = nil

local function ensureToasts()
	if toastContainer and toastContainer.Parent then
		return toastContainer
	end
	local gui = UiKit.Screen("BrainToasts", 50)
	toastContainer = UiKit.Mk("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.new(0.5, 0, 0.3, 0),
		Parent = gui,
	})
	UiKit.Mk("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = toastContainer,
	})
	return toastContainer
end

function UiKit.Toast(msg, kind)
	local container = ensureToasts()
	local color = UiKit.Colors.Panel
	if kind == "good" then
		color = Color3.fromRGB(35, 90, 50)
	elseif kind == "bad" then
		color = Color3.fromRGB(105, 40, 45)
	end
	local toast = UiKit.Mk("TextLabel", {
		BackgroundColor3 = color,
		BackgroundTransparency = 0.1,
		Font = Enum.Font.FredokaOne,
		TextColor3 = UiKit.Colors.Text,
		TextSize = 18,
		Text = "  " .. msg .. "  ",
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 0, 34),
		Parent = container,
	})
	UiKit.Round(toast, 10)
	UiKit.Stroke(toast)
	task.delay(3.5, function()
		if toast.Parent then
			local tween = TweenService:Create(toast, TweenInfo.new(0.4), { TextTransparency = 1, BackgroundTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			toast:Destroy()
		end
	end)
end

return UiKit
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX10">
					<Properties>
						<string name="Name">MenuUi</string>
						<ProtectedString name="Source">-- ============================================================
-- Menues: HUD-Knoepfe, Starterauswahl, Team und Brain-Dex.
-- ============================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared:WaitForChild("GameData"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))

local MenuUi = {}

local data = nil
local callbacks = nil

local menuGui = nil
local teamPanel = nil
local teamScroll = nil
local dexPanel = nil
local dexScroll = nil
local dexProgress = nil
local starterModal = nil
local starterCards = nil

local function hex(color)
	return string.format(
		"#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

-- ---------- Panel-Grundgeruest ----------

local function makePanel(title, size)
	local panel = UiKit.Mk("Frame", {
		BackgroundColor3 = UiKit.Colors.Panel,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = size,
		Visible = false,
		Parent = menuGui,
	})
	UiKit.Round(panel, 14)
	UiKit.Stroke(panel, Color3.fromRGB(15, 15, 25), 3)

	UiKit.Label({
		Text = title,
		Size = UDim2.new(1, -60, 0, 34),
		Position = UDim2.new(0, 14, 0, 8),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = panel,
	})

	UiKit.Button({
		Text = "X",
		BackgroundColor3 = UiKit.Colors.Bad,
		Size = UDim2.new(0, 34, 0, 34),
		Position = UDim2.new(1, -42, 0, 8),
		Parent = panel,
	}, function()
		panel.Visible = false
	end)

	return panel
end

local function clearRows(container)
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Frame") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end
end

-- ---------- Team-Panel ----------

local function addTeamRow(container, order, mon, isTeam, index)
	local sp = GameData.Species[mon.id]
	local stats = GameData.StatsFor(mon.id, mon.level)
	local row = UiKit.Mk("Frame", {
		BackgroundColor3 = UiKit.Colors.PanelLight,
		Size = UDim2.new(1, -8, 0, 56),
		LayoutOrder = order,
		Parent = container,
	})
	UiKit.Round(row, 10)

	UiKit.Label({
		RichText = true,
		Text = '&lt;font color="' .. hex(GameData.TypeColors[sp.typ]) .. '"&gt;●&lt;/font&gt; ' .. sp.name .. "   Lv. " .. mon.level,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 10, 0, 4),
		Size = UDim2.new(0.58, 0, 0, 22),
		Parent = row,
	})
	UiKit.Label({
		Text = "HP " .. mon.hp .. "/" .. stats.maxHp,
		TextColor3 = UiKit.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 10, 0, 30),
		Size = UDim2.new(0, 90, 0, 18),
		Parent = row,
	})
	local bar = UiKit.HpBar({
		Position = UDim2.new(0, 106, 0, 33),
		Size = UDim2.new(0.24, 0, 0, 12),
		Parent = row,
	})
	bar.Set(mon.hp, stats.maxHp, true)

	if isTeam then
		if index &gt; 1 then
			UiKit.Button({
				Text = "Anführer",
				BackgroundColor3 = UiKit.Colors.Blue,
				Position = UDim2.new(0.62, 0, 0.5, -15),
				Size = UDim2.new(0.18, 0, 0, 30),
				Parent = row,
			}, function()
				callbacks.onTeamAction("leader", index)
			end)
		end
		if data and #data.team &gt; 1 then
			UiKit.Button({
				Text = "→ Box",
				Position = UDim2.new(0.815, 0, 0.5, -15),
				Size = UDim2.new(0.16, 0, 0, 30),
				Parent = row,
			}, function()
				callbacks.onTeamAction("toBox", index)
			end)
		end
	else
		if data and #data.team &lt; GameData.TEAM_SIZE then
			UiKit.Button({
				Text = "→ Team",
				BackgroundColor3 = UiKit.Colors.Good,
				Position = UDim2.new(0.78, 0, 0.5, -15),
				Size = UDim2.new(0.19, 0, 0, 30),
				Parent = row,
			}, function()
				callbacks.onTeamAction("fromBox", index)
			end)
		end
	end
end

local function renderTeam()
	if not data then return end
	clearRows(teamScroll)
	local order = 1
	for i, mon in ipairs(data.team) do
		addTeamRow(teamScroll, order, mon, true, i)
		order = order + 1
	end
	local header = UiKit.Label({
		Text = "Box (" .. #data.box .. "/" .. GameData.BOX_SIZE .. ")",
		TextColor3 = UiKit.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -8, 0, 26),
		LayoutOrder = order,
		Parent = teamScroll,
	})
	header.Name = "BoxHeader"
	order = order + 1
	for i, mon in ipairs(data.box) do
		addTeamRow(teamScroll, order, mon, false, i)
		order = order + 1
	end
end

-- ---------- Brain-Dex ----------

local function renderDex()
	if not data then return end
	clearRows(dexScroll)
	local caughtCount = 0
	for i, id in ipairs(GameData.DexOrder) do
		local sp = GameData.Species[id]
		local caught = data.dex[id] == true
		if caught then
			caughtCount = caughtCount + 1
		end
		local card = UiKit.Mk("Frame", {
			BackgroundColor3 = caught and GameData.TypeColors[sp.typ]:Lerp(Color3.new(0, 0, 0), 0.55) or Color3.fromRGB(48, 48, 62),
			LayoutOrder = i,
			Parent = dexScroll,
		})
		UiKit.Round(card, 10)
		UiKit.Label({
			Text = "#" .. i,
			TextColor3 = UiKit.Colors.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.new(0, 6, 0, 2),
			Size = UDim2.new(0.5, 0, 0, 14),
			Parent = card,
		})
		UiKit.Label({
			Text = caught and sp.name or "???",
			Position = UDim2.new(0, 4, 0, 18),
			Size = UDim2.new(1, -8, 0, 34),
			TextColor3 = caught and UiKit.Colors.Text or Color3.fromRGB(120, 120, 135),
			Parent = card,
		})
		UiKit.Label({
			Text = caught and (sp.typ .. " • " .. sp.rarity) or "Noch nicht gefangen",
			TextColor3 = caught and GameData.Rarities[sp.rarity].color or Color3.fromRGB(100, 100, 115),
			Position = UDim2.new(0, 4, 0, 56),
			Size = UDim2.new(1, -8, 0, 16),
			Parent = card,
		})
	end
	dexProgress.Text = "Entdeckt: " .. caughtCount .. " / " .. #GameData.DexOrder
end

-- ---------- Starterauswahl ----------

local function buildStarterModal()
	starterModal = UiKit.Mk("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Size = UDim2.new(1, 0, 1, 0),
		Visible = false,
		ZIndex = 5,
		Parent = menuGui,
	})
	local panel = UiKit.Mk("Frame", {
		BackgroundColor3 = UiKit.Colors.Panel,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0.72, 0, 0.66, 0),
		ZIndex = 5,
		Parent = starterModal,
	})
	UiKit.Round(panel, 16)
	UiKit.Stroke(panel, UiKit.Colors.Accent, 3)
	UiKit.Label({
		Text = "Wähle dein erstes Brain Word!",
		Size = UDim2.new(1, 0, 0.14, 0),
		ZIndex = 5,
		Parent = panel,
	})
	starterCards = UiKit.Mk("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0.16, 0),
		Size = UDim2.new(1, 0, 0.84, 0),
		ZIndex = 5,
		Parent = panel,
	})
	UiKit.Mk("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0.02, 0),
		Parent = starterCards,
	})
end

function MenuUi.ShowStarter(options)
	for _, child in ipairs(starterCards:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for _, id in ipairs(options) do
		local sp = GameData.Species[id]
		local card = UiKit.Mk("Frame", {
			BackgroundColor3 = UiKit.Colors.PanelLight,
			Size = UDim2.new(0.3, 0, 0.9, 0),
			ZIndex = 5,
			Parent = starterCards,
		})
		UiKit.Round(card, 14)
		UiKit.Stroke(card, GameData.TypeColors[sp.typ], 3)
		UiKit.Label({
			Text = sp.name,
			TextColor3 = GameData.TypeColors[sp.typ],
			Position = UDim2.new(0, 0, 0.04, 0),
			Size = UDim2.new(1, 0, 0.18, 0),
			ZIndex = 5,
			Parent = card,
		})
		UiKit.Label({
			Text = "Typ: " .. sp.typ,
			Position = UDim2.new(0, 0, 0.24, 0),
			Size = UDim2.new(1, 0, 0.1, 0),
			TextColor3 = UiKit.Colors.TextDim,
			ZIndex = 5,
			Parent = card,
		})
		UiKit.Label({
			Text = sp.desc,
			TextWrapped = true,
			TextScaled = false,
			TextSize = 16,
			Position = UDim2.new(0.05, 0, 0.38, 0),
			Size = UDim2.new(0.9, 0, 0.36, 0),
			ZIndex = 5,
			Parent = card,
		})
		local pick = UiKit.Button({
			Text = "Nehmen!",
			BackgroundColor3 = UiKit.Colors.Good,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 0.97, 0),
			Size = UDim2.new(0.8, 0, 0.14, 0),
			ZIndex = 5,
			Parent = card,
		}, function()
			starterModal.Visible = false
			callbacks.onStarterPick(id)
		end)
		pick.ZIndex = 5
	end
	starterModal.Visible = true
end

-- ---------- Oeffentliche API ----------

function MenuUi.SetData(newData)
	data = newData
	if teamPanel.Visible then
		renderTeam()
	end
	if dexPanel.Visible then
		renderDex()
	end
end

function MenuUi.CloseAll()
	teamPanel.Visible = false
	dexPanel.Visible = false
end

function MenuUi.Init(cb)
	callbacks = cb
	menuGui = UiKit.Screen("BrainMenus", 10)

	-- Team-Panel
	teamPanel = makePanel("Dein Team", UDim2.new(0.44, 0, 0.74, 0))
	teamScroll = UiKit.Mk("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 50),
		Size = UDim2.new(1, -20, 1, -60),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Parent = teamPanel,
	})
	UiKit.Mk("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = teamScroll,
	})

	-- Brain-Dex-Panel
	dexPanel = makePanel("Brain-Dex", UDim2.new(0.56, 0, 0.78, 0))
	dexProgress = UiKit.Label({
		Text = "Entdeckt: 0 / 0",
		TextColor3 = UiKit.Colors.Accent,
		Position = UDim2.new(0, 14, 0, 42),
		Size = UDim2.new(1, -28, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = dexPanel,
	})
	dexScroll = UiKit.Mk("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 68),
		Size = UDim2.new(1, -20, 1, -78),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Parent = dexPanel,
	})
	UiKit.Mk("UIGridLayout", {
		CellSize = UDim2.new(0, 128, 0, 78),
		CellPadding = UDim2.new(0, 8, 0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = dexScroll,
	})

	buildStarterModal()

	-- HUD unten links
	local hud = UiKit.Mk("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -14),
		Size = UDim2.new(0, 130, 0, 104),
		Parent = menuGui,
	})
	UiKit.Mk("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 8),
		Parent = hud,
	})
	UiKit.Button({
		Text = "Team",
		BackgroundColor3 = UiKit.Colors.Blue,
		Size = UDim2.new(1, 0, 0, 44),
		Parent = hud,
	}, function()
		dexPanel.Visible = false
		teamPanel.Visible = not teamPanel.Visible
		if teamPanel.Visible then
			renderTeam()
		end
	end)
	UiKit.Button({
		Text = "Brain-Dex",
		BackgroundColor3 = Color3.fromRGB(150, 90, 220),
		Size = UDim2.new(1, 0, 0, 44),
		Parent = hud,
	}, function()
		teamPanel.Visible = false
		dexPanel.Visible = not dexPanel.Visible
		if dexPanel.Visible then
			renderDex()
		end
	end)

	-- Kleiner Hinweis unten in der Mitte
	UiKit.Label({
		Text = "Gehe zu einem wilden Brain Word und drücke den Kampf-Knopf (Taste E)!",
		TextColor3 = Color3.fromRGB(235, 235, 245),
		TextStrokeTransparency = 0.4,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(0.6, 0, 0, 20),
		Parent = menuGui,
	})
end

return MenuUi
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX11">
					<Properties>
						<string name="Name">BattleUi</string>
						<ProtectedString name="Source">-- ============================================================
-- Die Kampf-Oberflaeche: HP-Balken, Attacken-Knoepfe,
-- Kampf-Text und Ergebnis-Banner.
-- ============================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared:WaitForChild("GameData"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))

local BattleUi = {}

local sendAction = nil
local gui = nil

local state = nil -- { ally, enemy, team, monIndex }
local locked = false

-- UI-Referenzen
local logLabel = nil
local buttonsArea = nil
local mainGrid = nil
local movesFrame = nil
local switchFrame = nil
local resultBanner = nil
local resultText = nil

local enemyName = nil
local enemyInfo = nil
local enemyBar = nil
local allyName = nil
local allyInfo = nil
local allyBar = nil
local allyHpText = nil
local xpFill = nil

local function constrain(label, maxSize)
	UiKit.Mk("UITextSizeConstraint", { MaxTextSize = maxSize, Parent = label })
	return label
end

local function setLog(msg)
	logLabel.Text = msg
end

-- ---------- Anzeigen aktualisieren ----------

local function renderEnemy(instant)
	if not state or not state.enemy then return end
	local e = state.enemy
	enemyName.Text = e.name .. "   Lv. " .. e.level
	enemyInfo.Text = e.typ .. " • " .. e.rarity
	enemyInfo.TextColor3 = GameData.Rarities[e.rarity].color
	enemyBar.Set(e.hp, e.maxHp, instant)
end

local function renderAlly(instant)
	if not state or not state.ally then return end
	local a = state.ally
	allyName.Text = a.name .. "   Lv. " .. a.level
	allyInfo.Text = a.typ
	allyInfo.TextColor3 = GameData.TypeColors[a.typ]
	allyBar.Set(a.hp, a.maxHp, instant)
	allyHpText.Text = a.hp .. " / " .. a.maxHp
	local frac = 0
	if a.xpNext and a.xpNext &gt; 0 then
		frac = math.max(0, math.min(1, a.xp / a.xpNext))
	end
	xpFill.Size = UDim2.new(frac, 0, 1, 0)
end

-- ---------- Untermenues ----------

local function showMain()
	mainGrid.Visible = true
	movesFrame.Visible = false
	switchFrame.Visible = false
end

local function send(action)
	if locked then return end
	locked = true
	buttonsArea.Visible = false
	sendAction(action)
end

local function showMoves()
	for _, child in ipairs(movesFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	for i, move in ipairs(state.ally.moves) do
		local color = GameData.TypeColors[move.typ]:Lerp(Color3.new(0, 0, 0), 0.35)
		local btn = UiKit.Button({
			Text = move.name .. "\n" .. move.typ .. " • Stärke " .. move.power,
			BackgroundColor3 = color,
			LayoutOrder = i,
			Parent = movesFrame,
		}, function()
			send({ kind = "move", index = i })
		end)
		constrain(btn, 18)
	end
	local back = UiKit.Button({
		Text = "Zurück",
		BackgroundColor3 = Color3.fromRGB(90, 90, 110),
		LayoutOrder = 9,
		Parent = movesFrame,
	}, showMain)
	constrain(back, 18)
	mainGrid.Visible = false
	movesFrame.Visible = true
	switchFrame.Visible = false
end

local function showSwitch(forced)
	for _, child in ipairs(switchFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	for i, mon in ipairs(state.team) do
		local usable = mon.hp &gt; 0 and i ~= state.monIndex
		local color = usable and GameData.TypeColors[mon.typ]:Lerp(Color3.new(0, 0, 0), 0.4) or Color3.fromRGB(60, 60, 70)
		local label = mon.name .. " Lv." .. mon.level .. "\n" .. mon.hp .. "/" .. mon.maxHp
		if mon.hp &lt;= 0 then
			label = mon.name .. "\nK.O."
		elseif i == state.monIndex then
			label = mon.name .. "\nim Kampf"
		end
		local btn = UiKit.Button({
			Text = label,
			BackgroundColor3 = color,
			LayoutOrder = i,
			Parent = switchFrame,
		}, function()
			if usable then
				send({ kind = "switch", index = i })
			end
		end)
		constrain(btn, 16)
	end
	if not forced then
		local back = UiKit.Button({
			Text = "Zurück",
			BackgroundColor3 = Color3.fromRGB(90, 90, 110),
			LayoutOrder = 9,
			Parent = switchFrame,
		}, showMain)
		constrain(back, 16)
	end
	mainGrid.Visible = false
	movesFrame.Visible = false
	switchFrame.Visible = true
end

-- ---------- Ergebnis-Banner ----------

local RESULTS = {
	sieg = { text = "SIEG!", color = Color3.fromRGB(60, 160, 80) },
	gefangen = { text = "GEFANGEN!", color = Color3.fromRGB(70, 130, 220) },
	geflohen = { text = "Entkommen!", color = Color3.fromRGB(120, 120, 140) },
	niederlage = { text = "K.O. ...", color = Color3.fromRGB(170, 60, 60) },
}

-- ---------- Ablauf ----------

function BattleUi.Start(payload)
	state = {
		ally = payload.ally,
		enemy = payload.enemy,
		team = payload.team,
		monIndex = payload.monIndex,
	}
	locked = false
	renderAlly(true)
	renderEnemy(true)
	setLog("Ein wildes " .. payload.enemy.name .. " (Lv. " .. payload.enemy.level .. ") erscheint!")
	resultBanner.Visible = false
	buttonsArea.Visible = true
	showMain()
	gui.Enabled = true
end

function BattleUi.Update(payload)
	task.spawn(function()
		if not state then
			if payload.over then
				gui.Enabled = false
			end
			return
		end
		buttonsArea.Visible = false

		for _, ev in ipairs(payload.events) do
			if ev.t == "text" then
				setLog(ev.msg)
				task.wait(1.05)
			elseif ev.t == "hp" then
				if ev.side == "enemy" and state.enemy then
					state.enemy.hp = ev.hp
					enemyBar.Set(ev.hp, state.enemy.maxHp, false)
				elseif state.ally then
					state.ally.hp = ev.hp
					allyBar.Set(ev.hp, state.ally.maxHp, false)
					allyHpText.Text = ev.hp .. " / " .. state.ally.maxHp
				end
				task.wait(0.5)
			elseif ev.t == "ally" then
				state.ally = ev.view
				renderAlly(true)
				task.wait(0.35)
			end
		end

		-- Endstand uebernehmen
		if payload.ally then state.ally = payload.ally end
		if payload.enemy then state.enemy = payload.enemy end
		if payload.team then state.team = payload.team end
		if payload.monIndex then state.monIndex = payload.monIndex end
		renderAlly(true)
		renderEnemy(true)

		if payload.over then
			local info = RESULTS[payload.result]
			if info then
				resultText.Text = info.text
				resultBanner.BackgroundColor3 = info.color
				resultBanner.Visible = true
				task.wait(1.6)
			end
			gui.Enabled = false
			state = nil
			locked = false
		else
			locked = false
			buttonsArea.Visible = true
			if payload.forcedSwitch then
				setLog("Wähle dein nächstes Brain Word!")
				showSwitch(true)
			else
				showMain()
			end
		end
	end)
end

-- ---------- Aufbau ----------

function BattleUi.Init(sender)
	sendAction = sender
	gui = UiKit.Screen("BrainBattle", 20)
	gui.Enabled = false

	-- Abdunkelung
	UiKit.Mk("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = gui,
	})

	-- Gegner-Karte (oben rechts)
	local enemyCard = UiKit.Mk("Frame", {
		BackgroundColor3 = UiKit.Colors.Panel,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.98, 0, 0.05, 0),
		Size = UDim2.new(0.34, 0, 0.15, 0),
