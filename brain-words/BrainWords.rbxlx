					<string name="Name">PlayerData</string>
					<ProtectedString name="Source">-- ============================================================
-- Spielerdaten: Team, Box, Brain-Dex, Speichern &amp; Laden
-- ============================================================

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared:WaitForChild("GameData"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local PlayerData = {}

-- Wird von Main.server mit BattleService.IsInBattle ueberschrieben,
-- damit man das Team nicht mitten im Kampf umbauen kann.
PlayerData.IsBusy = function(_player)
	return false
end

local sessions = {} -- [player] = { team, box, dex, catches, starter }
local store = nil
local storeOk = false

local DataSyncRemote = nil
local NotifyRemote = nil
local StarterOfferRemote = nil

-- ---------- Hilfsfunktionen ----------

function PlayerData.NewMon(speciesId, level)
	local stats = GameData.StatsFor(speciesId, level)
	return { id = speciesId, level = level, xp = 0, hp = stats.maxHp }
end

function PlayerData.MaxHpOf(mon)
	return GameData.StatsFor(mon.id, mon.level).maxHp
end

local function defaultData()
	return { team = {}, box = {}, dex = {}, catches = 0, starter = false }
end

-- Geladene Daten absichern (falls alte/kaputte Speicherstaende existieren)
local function sanitizeMon(raw)
	if type(raw) ~= "table" then return nil end
	if type(raw.id) ~= "string" or not GameData.Species[raw.id] then return nil end
	local level = math.floor(tonumber(raw.level) or 1)
	if level &lt; 1 then level = 1 end
	if level &gt; GameData.MAX_LEVEL then level = GameData.MAX_LEVEL end
	local mon = PlayerData.NewMon(raw.id, level)
	local maxHp = PlayerData.MaxHpOf(mon)
	local xp = math.floor(tonumber(raw.xp) or 0)
	if xp &lt; 0 then xp = 0 end
	mon.xp = xp
	local hp = math.floor(tonumber(raw.hp) or maxHp)
	if hp &lt; 0 then hp = 0 end
	if hp &gt; maxHp then hp = maxHp end
	mon.hp = hp
	return mon
end

local function sanitize(raw)
	local data = defaultData()
	if type(raw) ~= "table" then return data end
	if type(raw.team) == "table" then
		for _, rawMon in ipairs(raw.team) do
			local mon = sanitizeMon(rawMon)
			if mon and #data.team &lt; GameData.TEAM_SIZE then
				table.insert(data.team, mon)
			end
		end
	end
	if type(raw.box) == "table" then
		for _, rawMon in ipairs(raw.box) do
			local mon = sanitizeMon(rawMon)
			if mon and #data.box &lt; GameData.BOX_SIZE then
				table.insert(data.box, mon)
			end
		end
	end
	if type(raw.dex) == "table" then
		for id, v in pairs(raw.dex) do
			if v and GameData.Species[id] then
				data.dex[id] = true
			end
		end
	end
	data.catches = math.floor(tonumber(raw.catches) or 0)
	data.starter = (raw.starter == true) and (#data.team &gt; 0)
	return data
end

local function keyFor(player)
	return "p_" .. player.UserId
end

local function saveNow(player)
	local session = sessions[player]
	if not session or not storeOk then return end
	local payload = {
		team = session.team,
		box = session.box,
		dex = session.dex,
		catches = session.catches,
		starter = session.starter,
	}
	local ok, err = pcall(function()
		store:SetAsync(keyFor(player), payload)
	end)
	if not ok then
		warn("[BrainWords] Speichern fehlgeschlagen fuer " .. player.Name .. ": " .. tostring(err))
	end
end

-- ---------- Oeffentliche API ----------

function PlayerData.SessionOf(player)
	return sessions[player]
end

function PlayerData.Notify(player, msg, kind)
	if NotifyRemote then
		NotifyRemote:FireClient(player, msg, kind or "info")
	end
end

local function updateLeaderstats(player)
	local session = sessions[player]
	local stats = player:FindFirstChild("leaderstats")
	if not session or not stats then return end
	local caught = stats:FindFirstChild("Gefangen")
	if caught then caught.Value = session.catches end
	local best = 0
	for _, mon in ipairs(session.team) do
		if mon.level &gt; best then best = mon.level end
	end
	local bestVal = stats:FindFirstChild("Bestes Lv")
	if bestVal then bestVal.Value = best end
end

function PlayerData.Sync(player)
	local session = sessions[player]
	if not session or not DataSyncRemote then return end
	updateLeaderstats(player)
	DataSyncRemote:FireClient(player, {
		team = session.team,
		box = session.box,
		dex = session.dex,
		catches = session.catches,
		starter = session.starter,
	})
end

function PlayerData.GiveStarter(player, speciesId)
	local session = sessions[player]
	if not session or session.starter then return end
	local valid = false
	for _, id in ipairs(GameData.Starters) do
		if id == speciesId then valid = true end
	end
	if not valid then return end
	table.insert(session.team, PlayerData.NewMon(speciesId, 5))
	session.dex[speciesId] = true
	session.starter = true
	PlayerData.Sync(player)
	PlayerData.Notify(player, GameData.Species[speciesId].name .. " ist jetzt dein Partner! Viel Erfolg!", "good")
end

-- Fuegt ein gefangenes Brain Word hinzu. Gibt "Team", "Box" oder nil zurueck.
function PlayerData.AddCaught(player, speciesId, level)
	local session = sessions[player]
	if not session then return nil end
	local mon = PlayerData.NewMon(speciesId, level)
	local dest = nil
	if #session.team &lt; GameData.TEAM_SIZE then
		table.insert(session.team, mon)
		dest = "Team"
	elseif #session.box &lt; GameData.BOX_SIZE then
		table.insert(session.box, mon)
		dest = "Box"
	end
	if dest then
		session.dex[speciesId] = true
		session.catches = session.catches + 1
	end
	PlayerData.Sync(player)
	return dest
end

function PlayerData.HealAll(player)
	local session = sessions[player]
	if not session then return end
	for _, mon in ipairs(session.team) do
		mon.hp = PlayerData.MaxHpOf(mon)
	end
	PlayerData.Sync(player)
end

-- Team-Verwaltung aus dem Menue
function PlayerData.HandleTeamAction(player, op, index)
	local session = sessions[player]
	if not session then return end
	if PlayerData.IsBusy(player) then
		PlayerData.Notify(player, "Nicht mitten im Kampf!", "bad")
		return
	end
	index = math.floor(tonumber(index) or 0)
	if op == "leader" then
		if index &gt;= 2 and index &lt;= #session.team then
			local mon = table.remove(session.team, index)
			table.insert(session.team, 1, mon)
		end
	elseif op == "toBox" then
		if index &gt;= 1 and index &lt;= #session.team and #session.team &gt; 1 and #session.box &lt; GameData.BOX_SIZE then
			local mon = table.remove(session.team, index)
			table.insert(session.box, mon)
		end
	elseif op == "fromBox" then
		if index &gt;= 1 and index &lt;= #session.box and #session.team &lt; GameData.TEAM_SIZE then
			local mon = table.remove(session.box, index)
			table.insert(session.team, mon)
		end
	end
	PlayerData.Sync(player)
end

-- ---------- Spieler-Lebenszyklus ----------

local function onPlayerAdded(player)
	-- Leaderboard
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local caught = Instance.new("IntValue")
	caught.Name = "Gefangen"
	caught.Value = 0
	caught.Parent = stats
	local best = Instance.new("IntValue")
	best.Name = "Bestes Lv"
	best.Value = 0
	best.Parent = stats
	stats.Parent = player

	-- Daten laden
	local raw = nil
	if storeOk then
		local ok, result = pcall(function()
			return store:GetAsync(keyFor(player))
		end)
		if ok then
			raw = result
		else
			warn("[BrainWords] Laden fehlgeschlagen fuer " .. player.Name .. ": " .. tostring(result))
		end
	end
	sessions[player] = sanitize(raw)
	updateLeaderstats(player)
end

local function onPlayerRemoving(player)
	saveNow(player)
	sessions[player] = nil
end

-- Client meldet: UI ist bereit -&gt; Daten schicken, ggf. Starterauswahl
local function onClientReady(player)
	-- Kurz warten, falls die Daten noch geladen werden
	local waited = 0
	while not sessions[player] and player.Parent and waited &lt; 15 do
		task.wait(0.25)
		waited = waited + 0.25
	end
	local session = sessions[player]
	if not session then return end
	PlayerData.Sync(player)
	if not session.starter then
		StarterOfferRemote:FireClient(player, GameData.Starters)
	else
		PlayerData.Notify(player, "Willkommen zurück, " .. player.DisplayName .. "!", "info")
	end
end

function PlayerData.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("BrainWords_v1")
	end)
	if ok then
		store = result
		storeOk = true
	else
		warn("[BrainWords] Kein DataStore-Zugriff (im Studio: API-Zugriff in den Spieleinstellungen aktivieren). Es wird nicht gespeichert.")
	end

	DataSyncRemote = Remotes.Get("DataSync")
	NotifyRemote = Remotes.Get("Notify")
	StarterOfferRemote = Remotes.Get("StarterOffer")

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	Remotes.Get("ClientReady").OnServerEvent:Connect(onClientReady)
	Remotes.Get("StarterChoose").OnServerEvent:Connect(function(player, speciesId)
		if type(speciesId) == "string" then
			PlayerData.GiveStarter(player, speciesId)
		end
	end)
	Remotes.Get("TeamAction").OnServerEvent:Connect(function(player, op, index)
		if type(op) == "string" then
			PlayerData.HandleTeamAction(player, op, index)
		end
	end)

	-- Automatisch alle 2 Minuten speichern
	task.spawn(function()
		while true do
			task.wait(120)
			for player in pairs(sessions) do
				saveNow(player)
			end
		end
	end)

	-- Beim Schliessen des Servers alle speichern
	game:BindToClose(function()
		for player in pairs(sessions) do
			saveNow(player)
		end
	end)
end

return PlayerData
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX5">
				<Properties>
					<string name="Name">MapBuilder</string>
					<ProtectedString name="Source">-- ============================================================
-- Baut die komplette Spielwelt per Code:
-- Boden, Zonen, Schilder, Heil-Brunnen, Baeume, Deko.
-- ============================================================

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared:WaitForChild("GameData"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local MapBuilder = {}

local MAP_HALF = 310 -- halbe Kartengroesse
local rng = Random.new(20240521)

local function part(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

-- Aufrecht stehender Zylinder (Zylinder-Achse ist standardmaessig X)
local function uprightCylinderCFrame(x, y, z)
	return CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(90))
end

local function makeTree(folder, x, z)
	part({
		Name = "Baumstamm",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(7, 1.8, 1.8),
		CFrame = uprightCylinderCFrame(x, 3.5, z),
		Color = Color3.fromRGB(105, 70, 45),
		Material = Enum.Material.Wood,
	}, folder)
	local leafColors = {
		Color3.fromRGB(70, 155, 70),
		Color3.fromRGB(90, 175, 75),
		Color3.fromRGB(60, 140, 90),
	}
	local size = rng:NextNumber(7, 11)
	part({
		Name = "Blaetter",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(size, size, size),
		CFrame = CFrame.new(x, 7 + size * 0.25, z),
		Color = leafColors[rng:NextInteger(1, #leafColors)],
		Material = Enum.Material.Grass,
		CanCollide = false,
	}, folder)
end

local function makeSign(folder, zone)
	local flat = Vector3.new(zone.center.X, 0, zone.center.Z)
	local dir = (Vector3.new(0, 0, 0) - flat).Unit
	local pos = flat + dir * (zone.radius + 8)

	part({
		Name = "Pfosten",
		Size = Vector3.new(0.8, 5, 0.8),
		CFrame = CFrame.new(pos.X, 2.5, pos.Z),
		Color = Color3.fromRGB(120, 85, 55),
		Material = Enum.Material.Wood,
	}, folder)

	local board = part({
		Name = "Schild_" .. zone.id,
		Size = Vector3.new(9, 4, 0.5),
		CFrame = CFrame.lookAt(Vector3.new(pos.X, 5.5, pos.Z), Vector3.new(0, 5.5, 0)),
		Color = Color3.fromRGB(235, 225, 200),
		Material = Enum.Material.SmoothPlastic,
	}, folder)

	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, 0, 0.55, 0)
		title.BackgroundTransparency = 1
		title.Font = Enum.Font.FredokaOne
		title.TextScaled = true
		title.TextColor3 = Color3.fromRGB(50, 40, 30)
		title.Text = zone.name
		title.Parent = gui
		local sub = Instance.new("TextLabel")
		sub.Position = UDim2.new(0, 0, 0.55, 0)
		sub.Size = UDim2.new(1, 0, 0.45, 0)
		sub.BackgroundTransparency = 1
		sub.Font = Enum.Font.FredokaOne
		sub.TextScaled = true
		sub.TextColor3 = Color3.fromRGB(110, 90, 60)
		sub.Text = "Level " .. zone.levelMin .. " - " .. zone.levelMax
		sub.Parent = gui
		gui.Parent = board
	end
end

local function makeFountain(folder)
	local base = part({
		Name = "Brunnen",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 18, 18),
		CFrame = uprightCylinderCFrame(0, 1, 0),
		Color = Color3.fromRGB(180, 185, 195),
		Material = Enum.Material.Marble,
	}, folder)

	part({
		Name = "BrunnenWasser",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 15, 15),
		CFrame = uprightCylinderCFrame(0, 2, 0),
		Color = Color3.fromRGB(80, 170, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.25,
		CanCollide = false,
	}, folder)

	local orb = part({
		Name = "HeilKugel",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(5, 5, 5),
		CFrame = CFrame.new(0, 7, 0),
		Color = Color3.fromRGB(120, 200, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.15,
		CanCollide = false,
	}, folder)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(120, 200, 255)
	light.Range = 30
	light.Brightness = 1.5
	light.Parent = orb

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(300, 60)
	billboard.StudsOffset = Vector3.new(0, 5, 0)
	billboard.MaxDistance = 120
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "Heil-Brunnen"
	label.TextColor3 = Color3.fromRGB(160, 220, 255)
	label.TextStrokeTransparency = 0.3
	label.Parent = billboard
	billboard.Parent = orb

	-- Unsichtbare Heilzone
	local healZone = part({
		Name = "HeilZone",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(8, 24, 24),
		CFrame = uprightCylinderCFrame(0, 4, 0),
		Transparency = 1,
		CanCollide = false,
	}, folder)

	local lastHeal = {} -- [player] = Zeitpunkt
	healZone.Touched:Connect(function(hit)
		local character = hit.Parent
		if not character then return end
		local player = Players:GetPlayerFromCharacter(character)
		if not player then return end
		local now = os.clock()
		if lastHeal[player] and now - lastHeal[player] &lt; 6 then return end
		lastHeal[player] = now
		PlayerData.HealAll(player)
		PlayerData.Notify(player, "Deine Brain Words wurden geheilt!", "good")
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastHeal[player] = nil
	end)
end

function MapBuilder.Build()
	local folder = Instance.new("Folder")
	folder.Name = "BrainWordsMap"

	-- Boden
	part({
		Name = "Boden",
		Size = Vector3.new(MAP_HALF * 2, 2, MAP_HALF * 2),
		CFrame = CFrame.new(0, -1, 0),
		Color = Color3.fromRGB(106, 170, 80),
		Material = Enum.Material.Grass,
	}, folder)

	-- Unsichtbare Waende, damit niemand herunterfaellt
	local wallDefs = {
		{ Vector3.new(MAP_HALF * 2, 60, 4), CFrame.new(0, 30, -MAP_HALF) },
		{ Vector3.new(MAP_HALF * 2, 60, 4), CFrame.new(0, 30, MAP_HALF) },
		{ Vector3.new(4, 60, MAP_HALF * 2), CFrame.new(-MAP_HALF, 30, 0) },
		{ Vector3.new(4, 60, MAP_HALF * 2), CFrame.new(MAP_HALF, 30, 0) },
	}
	for _, def in ipairs(wallDefs) do
		part({ Name = "Wand", Size = def[1], CFrame = def[2], Transparency = 1 }, folder)
	end

	-- Spawn
	local spawnLoc = Instance.new("SpawnLocation")
	spawnLoc.Size = Vector3.new(14, 1, 14)
	spawnLoc.CFrame = CFrame.new(0, 0.5, 34)
	spawnLoc.Anchored = true
	spawnLoc.Duration = 0
	spawnLoc.Color = Color3.fromRGB(230, 230, 240)
	spawnLoc.Material = Enum.Material.SmoothPlastic
	spawnLoc.TopSurface = Enum.SurfaceType.Smooth
	spawnLoc.Parent = folder

	-- Zonen (farbige Flaechen + Schilder)
	for _, zone in ipairs(GameData.Zones) do
		part({
			Name = "Zone_" .. zone.id,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, zone.radius * 2, zone.radius * 2),
			CFrame = uprightCylinderCFrame(zone.center.X, -0.05, zone.center.Z),
			Color = zone.color,
			Material = Enum.Material.Grass,
			Transparency = 0.2,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
		}, folder)
		makeSign(folder, zone)
	end

	-- Kristalle auf dem Legenden-Gipfel
	local gipfel = GameData.Zones[#GameData.Zones]
	for _ = 1, 7 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(10, gipfel.radius * 0.8)
		local x = gipfel.center.X + math.cos(ang) * dist
		local z = gipfel.center.Z + math.sin(ang) * dist
		local h = rng:NextNumber(4, 8)
		part({
			Name = "Kristall",
			Size = Vector3.new(2, h, 2),
			CFrame = CFrame.new(x, h * 0.4, z) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)),
			Color = Color3.fromRGB(255, 220, 120),
			Material = Enum.Material.Neon,
			Transparency = 0.2,
			CanCollide = false,
		}, folder)
	end

	-- Baeume verstreuen (nicht direkt am Spawn/Brunnen)
	for _ = 1, 34 do
		local x = rng:NextNumber(-MAP_HALF + 20, MAP_HALF - 20)
		local z = rng:NextNumber(-MAP_HALF + 20, MAP_HALF - 20)
		if math.sqrt(x * x + z * z) &gt; 45 then
			makeTree(folder, x, z)
		end
	end

	-- Steine
	for _ = 1, 12 do
		local x = rng:NextNumber(-MAP_HALF + 15, MAP_HALF - 15)
		local z = rng:NextNumber(-MAP_HALF + 15, MAP_HALF - 15)
		if math.sqrt(x * x + z * z) &gt; 40 then
			local size = rng:NextNumber(3, 6)
			part({
				Name = "Stein",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(size, size, size),
				CFrame = CFrame.new(x, size * 0.25, z),
				Color = Color3.fromRGB(140, 140, 145),
				Material = Enum.Material.Slate,
			}, folder)
		end
	end

	makeFountain(folder)
	folder.Parent = workspace

	-- Licht &amp; Stimmung
	Lighting.ClockTime = 13.5
	Lighting.Brightness = 2.5
	Lighting.Ambient = Color3.fromRGB(120, 120, 130)
	Lighting.OutdoorAmbient = Color3.fromRGB(165, 175, 190)
end

return MapBuilder
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6">
				<Properties>
					<string name="Name">SpawnService</string>
					<ProtectedString name="Source">-- ============================================================
-- Laesst wilde Brain Words in den Zonen erscheinen.
-- Jedes wilde Brain Word ist eine leuchtende Kugel mit
-- schwebendem Namen und einem "Kaempfen!"-Knopf (Taste E).
-- ============================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared:WaitForChild("GameData"))

local SpawnService = {}

local LIFETIME = 130 -- Sekunden, bis ein unberuehrtes Brain Word verschwindet

local rng = Random.new()
local records = {} -- [model] = { id, level, zoneId, born }
local folder = nil
local onPromptTriggered = nil -- Callback aus Main (startet den Kampf)

local function pickSpecies(zone)
	local total = 0
	for _, entry in ipairs(zone.pool) do
		total = total + entry[2]
	end
	local roll = rng:NextNumber(0, total)
	for _, entry in ipairs(zone.pool) do
		roll = roll - entry[2]
		if roll &lt;= 0 then
			return entry[1]
		end
	end
	return zone.pool[1][1]
end

local function spawnOne(zone)
	local speciesId = pickSpecies(zone)
	local sp = GameData.Species[speciesId]
	local level = rng:NextInteger(zone.levelMin, zone.levelMax)

	-- Position: zufaellig in der Zone verteilt
	local ang = rng:NextNumber(0, math.pi * 2)
	local dist = zone.radius * 0.9 * math.sqrt(rng:NextNumber())
	local x = zone.center.X + math.cos(ang) * dist
	local z = zone.center.Z + math.sin(ang) * dist

	local orb = Instance.new("Part")
	orb.Name = sp.name
	orb.Shape = Enum.PartType.Ball
	orb.Size = Vector3.new(2.6, 2.6, 2.6)
	orb.CFrame = CFrame.new(x, 3, z)
	orb.Anchored = true
	orb.CanCollide = false
	orb.CastShadow = false
	orb.Material = Enum.Material.Neon
	orb.Color = GameData.TypeColors[sp.typ]
	orb:SetAttribute("SpeciesId", speciesId)
	orb:SetAttribute("Level", level)

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(230, 84)
	billboard.StudsOffset = Vector3.new(0, 2.8, 0)
	billboard.MaxDistance = 170

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 0.62, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.FredokaOne
	nameLabel.TextScaled = true
	nameLabel.Text = sp.name
	nameLabel.TextColor3 = GameData.Rarities[sp.rarity].color
	nameLabel.TextStrokeTransparency = 0.15
	nameLabel.Parent = billboard

	local subLabel = Instance.new("TextLabel")
	subLabel.Position = UDim2.new(0, 0, 0.62, 0)
	subLabel.Size = UDim2.new(1, 0, 0.38, 0)
	subLabel.BackgroundTransparency = 1
	subLabel.Font = Enum.Font.FredokaOne
	subLabel.TextScaled = true
	subLabel.Text = "Lv. " .. level .. "  •  " .. sp.typ
	subLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	subLabel.TextStrokeTransparency = 0.3
	subLabel.Parent = billboard
	billboard.Parent = orb

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Kämpfen!"
	prompt.ObjectText = sp.name .. " (Lv. " .. level .. ")"
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = 15
	prompt.RequiresLineOfSight = false
	prompt.Parent = orb
	prompt.Triggered:Connect(function(player)
		if onPromptTriggered then
			onPromptTriggered(player, orb)
		end
	end)

	CollectionService:AddTag(orb, "BrainWordSpawn")
	records[orb] = { id = speciesId, level = level, zoneId = zone.id, born = os.clock() }
	orb.Parent = folder
end

-- Nimmt ein wildes Brain Word aus der Welt (fuer den Kampfstart).
-- Gibt den Datensatz zurueck - oder nil, falls es schon weg ist.
function SpawnService.Take(model)
	local rec = records[model]
	if not rec then return nil end
	records[model] = nil
	model:Destroy()
	return rec
end

local function zoneLoop(zone)
	while true do
		-- Alte Spawns aufraeumen
		local now = os.clock()
		local count = 0
		for model, rec in pairs(records) do
			if rec.zoneId == zone.id then
				if now - rec.born &gt; LIFETIME then
					records[model] = nil
					model:Destroy()
				else
					count = count + 1
				end
			end
		end
		-- Nachschub
		if count &lt; zone.maxActive then
			spawnOne(zone)
		end
		task.wait(rng:NextNumber(4, 7))
	end
end

function SpawnService.Init(promptCallback)
	onPromptTriggered = promptCallback
	folder = Instance.new("Folder")
	folder.Name = "WildeBrainWords"
	folder.Parent = workspace
	for _, zone in ipairs(GameData.Zones) do
		task.spawn(zoneLoop, zone)
	end
end

return SpawnService
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX7">
				<Properties>
					<string name="Name">BattleService</string>
					<ProtectedString name="Source">-- ============================================================
-- Rundenbasiertes Kampfsystem (Server-Seite).
-- Der Server berechnet alles, der Client zeigt es nur an.
-- ============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared:WaitForChild("GameData"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local SpawnService = require(script.Parent:WaitForChild("SpawnService"))

local BattleService = {}

local rng = Random.new()
local battles = {} -- [player] = Kampfzustand
local BattleStartRemote = nil
local BattleUpdateRemote = nil

-- ---------- Ansichten fuer den Client ----------

local function movesView(moveIds)
	local list = {}
	for _, moveId in ipairs(moveIds) do
		local move = GameData.Moves[moveId]
		table.insert(list, { name = move.name, typ = move.typ, power = move.power })
	end
	return list
end

local function allyView(mon)
	local sp = GameData.Species[mon.id]
	local stats = GameData.StatsFor(mon.id, mon.level)
	return {
		name = sp.name,
		typ = sp.typ,
		level = mon.level,
		hp = mon.hp,
		maxHp = stats.maxHp,
		xp = mon.xp,
		xpNext = GameData.XpToNext(mon.level),
		moves = movesView(GameData.MovesFor(mon.id, mon.level)),
	}
end

local function enemyView(enemy)
	local sp = GameData.Species[enemy.id]
	return {
		name = sp.name,
		typ = sp.typ,
		rarity = sp.rarity,
		level = enemy.level,
		hp = enemy.hp,
		maxHp = enemy.stats.maxHp,
	}
end

local function teamView(session)
	local list = {}
	for _, mon in ipairs(session.team) do
		local sp = GameData.Species[mon.id]
		table.insert(list, {
			name = sp.name,
			typ = sp.typ,
			level = mon.level,
			hp = mon.hp,
			maxHp = GameData.StatsFor(mon.id, mon.level).maxHp,
		})
	end
	return list
end

-- ---------- Hilfsfunktionen ----------

local function push(events, event)
	table.insert(events, event)
end

local function setFrozen(player, frozen)
	local character = player.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	if frozen then
		humanoid.WalkSpeed = 0
		humanoid.JumpHeight = 0
	else
		humanoid.WalkSpeed = 16
		humanoid.JumpHeight = 7.2
	end
end

local function calcDamage(attLevel, attAtk, defDef, moveId, attackerTyp, defenderTyp)
	local move = GameData.Moves[moveId]
	local stab = (move.typ == attackerTyp) and 1.5 or 1
	local mult = GameData.TypeMultiplier(move.typ, defenderTyp)
	local base = ((2 * attLevel / 5 + 2) * move.power * attAtk / math.max(defDef, 1)) / 30 + 3
	local dmg = math.floor(base * stab * mult * (0.85 + rng:NextNumber() * 0.15))
	if dmg &lt; 1 then dmg = 1 end
	return dmg, mult
end

local function pushEffectiveness(events, mult)
	if mult &gt; 1 then
		push(events, { t = "text", msg = "Sehr effektiv!" })
	elseif mult &lt; 1 then
		push(events, { t = "text", msg = "Nicht sehr effektiv..." })
	end
end

-- Angriff des Spieler-Brain-Words. Gibt true zurueck, wenn der Gegner besiegt wurde.
local function allyAttack(session, state, events, moveId)
	local mon = session.team[state.monIndex]
	local sp = GameData.Species[mon.id]
	local stats = GameData.StatsFor(mon.id, mon.level)
	local move = GameData.Moves[moveId]
	local dmg, mult = calcDamage(mon.level, stats.atk, state.enemy.stats.def, moveId, sp.typ, GameData.Species[state.enemy.id].typ)
	state.enemy.hp = math.max(0, state.enemy.hp - dmg)
	push(events, { t = "text", msg = sp.name .. " setzt " .. move.name .. " ein!" })
	push(events, { t = "hp", side = "enemy", hp = state.enemy.hp })
	pushEffectiveness(events, mult)
	if state.enemy.hp &lt;= 0 then
		push(events, { t = "text", msg = "Das wilde " .. GameData.Species[state.enemy.id].name .. " wurde besiegt!" })
		return true
	end
	return false
end

-- Der Gegner sucht sich eine (moeglichst effektive) Attacke aus
local function chooseEnemyMove(state, defenderTyp)
	local weights = {}
	local total = 0
	for _, moveId in ipairs(state.enemy.moves) do
		local move = GameData.Moves[moveId]
		local mult = GameData.TypeMultiplier(move.typ, defenderTyp)
		local w = move.power * mult
		table.insert(weights, { moveId, w })
		total = total + w
	end
	local roll = rng:NextNumber(0, total)
	for _, entry in ipairs(weights) do
		roll = roll - entry[2]
		if roll &lt;= 0 then
			return entry[1]
		end
	end
	return state.enemy.moves[1]
end

-- Angriff des Gegners. Gibt true zurueck, wenn das eigene Brain Word besiegt wurde.
local function enemyAttack(session, state, events)
	local mon = session.team[state.monIndex]
	local monSp = GameData.Species[mon.id]
	local enemySp = GameData.Species[state.enemy.id]
	local moveId = chooseEnemyMove(state, monSp.typ)
	local move = GameData.Moves[moveId]
	local myStats = GameData.StatsFor(mon.id, mon.level)
	local dmg, mult = calcDamage(state.enemy.level, state.enemy.stats.atk, myStats.def, moveId, enemySp.typ, monSp.typ)
	mon.hp = math.max(0, mon.hp - dmg)
	push(events, { t = "text", msg = "Das wilde " .. enemySp.name .. " setzt " .. move.name .. " ein!" })
	push(events, { t = "hp", side = "ally", hp = mon.hp })
	pushEffectiveness(events, mult)
	if mon.hp &lt;= 0 then
		push(events, { t = "text", msg = monSp.name .. " wurde besiegt!" })
		return true
	end
	return false
end

-- EP-Belohnung inkl. Level-Ups und Entwicklung
local function awardXp(session, state, events)
	local mon = session.team[state.monIndex]
	local enemySp = GameData.Species[state.enemy.id]
	local gain = GameData.XpGain(state.enemy.level, enemySp.rarity)
	mon.xp = mon.xp + gain
	push(events, { t = "text", msg = GameData.Species[mon.id].name .. " erhält " .. gain .. " EP!" })

	local changed = false
	while mon.level &lt; GameData.MAX_LEVEL and mon.xp &gt;= GameData.XpToNext(mon.level) do
		mon.xp = mon.xp - GameData.XpToNext(mon.level)
		local oldMax = GameData.StatsFor(mon.id, mon.level).maxHp
		mon.level = mon.level + 1
		local newMax = GameData.StatsFor(mon.id, mon.level).maxHp
		mon.hp = math.min(newMax, mon.hp + (newMax - oldMax))
		changed = true
		local sp = GameData.Species[mon.id]
		push(events, { t = "text", msg = sp.name .. " ist jetzt Level " .. mon.level .. "!" })
		local learned = GameData.MoveLearnedAt(mon.id, mon.level)
		if learned then
			push(events, { t = "text", msg = sp.name .. " lernt " .. GameData.Moves[learned].name .. "!" })
		end
		if sp.evolveLevel and sp.evolveTo and mon.level &gt;= sp.evolveLevel then
			local oldName = sp.name
			mon.id = sp.evolveTo
			session.dex[mon.id] = true
			mon.hp = GameData.StatsFor(mon.id, mon.level).maxHp
			push(events, { t = "text", msg = "WOW! " .. oldName .. " entwickelt sich zu " .. GameData.Species[mon.id].name .. "!" })
		end
	end
	if changed then
		push(events, { t = "ally", view = allyView(mon) })
	end
end

-- Was passiert, wenn das aktive Brain Word besiegt wurde
local function handleAllyFaint(player, session, state, events)
	local anyAlive = false
	for _, mon in ipairs(session.team) do
		if mon.hp &gt; 0 then
			anyAlive = true
		end
	end
	if anyAlive then
		state.forcedSwitch = true
		push(events, { t = "text", msg = "Wähle dein nächstes Brain Word!" })
	else
		state.over = true
		state.result = "niederlage"
		push(events, { t = "text", msg = "Alle deine Brain Words sind K.O.! Du wachst am Brunnen wieder auf..." })
		PlayerData.HealAll(player)
		local character = player.Character
		if character then
			character:PivotTo(CFrame.new(0, 4, 26))
		end
	end
end

local function cleanup(player)
	local state = battles[player]
	if not state then return end
	if state.charConn then
		state.charConn:Disconnect()
	end
	battles[player] = nil
	setFrozen(player, false)
end

-- ---------- Oeffentliche API ----------

function BattleService.IsInBattle(player)
	return battles[player] ~= nil
end

function BattleService.TryStartWild(player, model)
	if battles[player] then return end
	local session = PlayerData.SessionOf(player)
	if not session then return end
	if not session.starter or #session.team == 0 then
		PlayerData.Notify(player, "Wähle zuerst dein Start-Brain-Word!", "bad")
		return
	end
	local aliveIndex = nil
	for i, mon in ipairs(session.team) do
		if mon.hp &gt; 0 then
			aliveIndex = i
			break
		end
	end
	if not aliveIndex then
		PlayerData.Notify(player, "Deine Brain Words sind alle K.O.! Heile sie am Brunnen.", "bad")
		return
	end

	local rec = SpawnService.Take(model)
	if not rec then return end -- jemand anderes war schneller

	local stats = GameData.StatsFor(rec.id, rec.level)
	local state = {
		monIndex = aliveIndex,
		enemy = {
			id = rec.id,
			level = rec.level,
			hp = stats.maxHp,
			stats = stats,
			moves = GameData.MovesFor(rec.id, rec.level),
		},
		forcedSwitch = false,
		over = false,
		result = nil,
		busy = false,
		charConn = nil,
	}
	battles[player] = state
	setFrozen(player, true)

	-- Falls der Spieler seinen Charakter zuruecksetzt: Kampf abbrechen
	state.charConn = player.CharacterAdded:Connect(function()
		if battles[player] == state then
			cleanup(player)
			BattleUpdateRemote:FireClient(player, {
				events = {},
				over = true,
				result = "abbruch",
				forcedSwitch = false,
			})
		end
	end)

	BattleStartRemote:FireClient(player, {
		enemy = enemyView(state.enemy),
		ally = allyView(session.team[aliveIndex]),
		team = teamView(session),
		monIndex = aliveIndex,
	})
end

local function resolveAction(player, state, session, action, events)
	local kind = action.kind

	-- Nach einem K.O. ist nur Wechseln erlaubt
	if state.forcedSwitch and kind ~= "switch" then
		return false
	end

	if kind == "move" then
		local mon = session.team[state.monIndex]
		local myMoves = GameData.MovesFor(mon.id, mon.level)
		local index = math.floor(tonumber(action.index) or 0)
		local moveId = myMoves[index]
		if not moveId then return false end

		local myStats = GameData.StatsFor(mon.id, mon.level)
		local allyFirst = myStats.spd &gt;= state.enemy.stats.spd
		if allyFirst then
			local enemyDown = allyAttack(session, state, events, moveId)
			if enemyDown then
				awardXp(session, state, events)
				state.over = true
				state.result = "sieg"
			else
				local allyDown = enemyAttack(session, state, events)
				if allyDown then
					handleAllyFaint(player, session, state, events)
				end
			end
		else
			local allyDown = enemyAttack(session, state, events)
			if allyDown then
				handleAllyFaint(player, session, state, events)
			else
				local enemyDown = allyAttack(session, state, events, moveId)
				if enemyDown then
					awardXp(session, state, events)
					state.over = true
					state.result = "sieg"
				end
			end
		end
		return true

	elseif kind == "catch" then
		local enemySp = GameData.Species[state.enemy.id]
		if #session.team &gt;= GameData.TEAM_SIZE and #session.box &gt;= GameData.BOX_SIZE then
			push(events, { t = "text", msg = "Kein Platz mehr! Team und Box sind voll." })
			return true
		end
		push(events, { t = "text", msg = "Du wirfst eine Brain-Blase auf " .. enemySp.name .. "..." })
		local chance = GameData.CatchChance(enemySp.rarity, state.enemy.hp / state.enemy.stats.maxHp)
		if rng:NextNumber() &lt; chance then
			local dest = PlayerData.AddCaught(player, state.enemy.id, state.enemy.level)
			push(events, { t = "text", msg = "GEFANGEN! " .. enemySp.name .. " gehört jetzt dir! (" .. tostring(dest) .. ")" })
			awardXp(session, state, events)
			state.over = true
			state.result = "gefangen"
		else
			push(events, { t = "text", msg = enemySp.name .. " hat sich befreit!" })
			local allyDown = enemyAttack(session, state, events)
			if allyDown then
				handleAllyFaint(player, session, state, events)
			end
		end
		return true

	elseif kind == "switch" then
		local index = math.floor(tonumber(action.index) or 0)
		if index &lt; 1 or index &gt; #session.team or index == state.monIndex then return false end
		local target = session.team[index]
		if target.hp &lt;= 0 then return false end
		local wasForced = state.forcedSwitch
		state.forcedSwitch = false
		state.monIndex = index
		push(events, { t = "text", msg = "Los, " .. GameData.Species[target.id].name .. "!" })
		push(events, { t = "ally", view = allyView(target) })
		if not wasForced then
			local allyDown = enemyAttack(session, state, events)
			if allyDown then
				handleAllyFaint(player, session, state, events)
			end
		end
		return true

	elseif kind == "run" then
		local mon = session.team[state.monIndex]
		local myStats = GameData.StatsFor(mon.id, mon.level)
		local bonus = (myStats.spd - state.enemy.stats.spd) * 0.008
		if bonus &gt; 0.25 then bonus = 0.25 end
		if bonus &lt; -0.25 then bonus = -0.25 end
		if rng:NextNumber() &lt; 0.7 + bonus then
			push(events, { t = "text", msg = "Du bist entkommen!" })
			state.over = true
			state.result = "geflohen"
		else
			push(events, { t = "text", msg = "Du kommst nicht weg!" })
			local allyDown = enemyAttack(session, state, events)
			if allyDown then
				handleAllyFaint(player, session, state, events)
			end
		end
		return true
	end

	return false
end

local function onBattleAction(player, action)
	local state = battles[player]
	if not state or state.busy or state.over then return end
	if type(action) ~= "table" or type(action.kind) ~= "string" then return end
	local session = PlayerData.SessionOf(player)
	if not session then return end

	state.busy = true
	local events = {}
	local ok, err = pcall(function()
		return resolveAction(player, state, session, action, events)
	end)
	if not ok then
		warn("[BrainWords] Kampf-Fehler: " .. tostring(err))
		state.busy = false
		return
	end

	local mon = session.team[state.monIndex]
	BattleUpdateRemote:FireClient(player, {
		events = events,
		ally = mon and allyView(mon) or nil,
		enemy = enemyView(state.enemy),
		team = teamView(session),
		monIndex = state.monIndex,
		over = state.over,
		result = state.result,
		forcedSwitch = state.forcedSwitch,
	})

	if state.over then
		cleanup(player)
		PlayerData.Sync(player)
	else
		state.busy = false
	end
end

function BattleService.Init()
	BattleStartRemote = Remotes.Get("BattleStart")
	BattleUpdateRemote = Remotes.Get("BattleUpdate")
	Remotes.Get("BattleAction").OnServerEvent:Connect(onBattleAction)
	Players.PlayerRemoving:Connect(function(player)
		cleanup(player)
	end)
end

return BattleService
</ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerStorage" referent="RBX19">
	</Item>
	<Item class="StarterGui" referent="RBX20">
	</Item>
	<Item class="StarterPack" referent="RBX21">
	</Item>
	<Item class="StarterPlayer" referent="RBX24">
		<Item class="StarterPlayerScripts" referent="RBX23">
			<Item class="Folder" referent="RBX22">
				<Properties>
					<string name="Name">Client</string>
